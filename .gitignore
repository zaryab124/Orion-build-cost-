# Dependencies
node_modules/

# Local databases and locks
data/orion.db*

# Client file uploads and drawings (Never commit private CAD/PDF files)
storage/quotes/*
storage/drawings/*
data/quotes/*
!storage/quotes/.gitkeep
!storage/drawings/.gitkeep
!data/quotes/.gitkeep

# Environment and secrets (Never commit production credentials)
.env
.env.*
!.env.example

# Vercel and build artifacts
.vercel/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System files
.DS_Store
Thumbs.db
