# =================================================================
# Orion Build Cost - Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment.
# NEVER commit the real .env file or production secrets to Git.
# =================================================================

# Server & Network Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
NODE_VERSION=22

# Database Configuration
# Path to persistent SQLite database file (requires persistent disk volume on PaaS/Docker)
ORION_DB_PATH=./data/orion.db

# Storage Directories
# These directories hold private client CAD drawings, quote uploads, and RFQ packages.
# On persistent disk PaaS (Render, Railway, Fly.io, Docker), point these to your persistent mount volume.
# Example for Render with mountPath /var/data:
#   ORION_DB_PATH=/var/data/orion.db
#   ORION_STORAGE_DIR=/var/data/storage/quotes
#   ORION_DRAWINGS_DIR=/var/data/storage/drawings
#   ORION_DATA_DIR=/var/data/quotes
ORION_STORAGE_DIR=./storage/quotes
ORION_DRAWINGS_DIR=./storage/drawings
ORION_DATA_DIR=./data/quotes

# Security & Authentication
# 64-character random hex string for session security
ORION_SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string

# Demo Accounts Seeding
# In production (NODE_ENV=production), demo accounts are DISABLED by default.
# Only set to 'true' in a dedicated staging/demo sandbox where demonstration accounts are intended.
ORION_SEED_DEMO_ACCOUNTS=false

# Initial Production Administrator Bootstrap
# Use these variables to bootstrap your production administrator securely on initial startup.
# Passwords must be at least 12 characters. After the initial admin is created, these can be safely cleared.
ORION_ADMIN_EMAIL=director@orionbuildcost.co.uk
ORION_ADMIN_PASSWORD=replace_with_a_strong_production_password_min_16_chars
ORION_ADMIN_NAME=Production Director

# Email Service (SMTP) - Optional for transactional quote notifications & password resets
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_here
SMTP_FROM=enquiries@orionbuildcost.co.uk
